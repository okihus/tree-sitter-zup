{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "zup",
      "camelcase": "Zup",
      "title": "Zup",
      "scope": "source.zup",
      "path": ".",
      "file-types": [
        "zup"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^zup$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Zup grammar for tree-sitter",
    "authors": [
      {
        "name": "Oki Husso",
        "email": "oki.husso@hurja.fi"
      }
    ],
    "links": {
      "repository": "https://github.com/okihus/tree-sitter-zup"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
