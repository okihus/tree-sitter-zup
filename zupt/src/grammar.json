{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "zupt",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "section"
      }
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "section_header"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "section_body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "section_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "--[A-Z][A-Z0-9_]*--[ \\t]*"
      }
    },
    "section_body": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "body_line"
      }
    },
    "body_line": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}